div(class="mx-auto w-full px-4 pb-44 pt-4")
    header
        div(class="flex items-center gap-3")
            button(type="button", (click)="back()", class="flex size-10 shrink-0 items-center justify-center rounded-xl border border-[#E2D6CB] bg-[#FFFDF8] text-[#5D4E43]", aria-label="이전 화면")
                svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", class="size-5", aria-hidden="true")
                    path(d="m15 18-6-6 6-6", stroke-linecap="round", stroke-linejoin="round")
            div
                p(class="text-[10px] font-extrabold uppercase tracking-[0.14em] text-[#E96B2C]") Step {{step}} of 2
                h1(class="mt-0.5 text-2xl font-black tracking-[-0.04em] text-[#2F241D]") 주문하기

        ol(class="mt-5 grid grid-cols-2", aria-label="주문 진행 단계")
            li(class="relative flex items-center")
                div(class="absolute left-7 right-0 top-4 h-0.5", [ngClass]="step >= 2 ? 'bg-[#2E7D32]' : 'bg-[#DED2C7]'", aria-hidden="true")
                div(class="relative z-10 flex items-center gap-2 bg-[#F8F5F0] pr-2", [attr.aria-current]="step === 1 ? 'step' : null")
                    span(class="flex size-8 items-center justify-center rounded-full border-2 text-xs font-black", [ngClass]="step > 1 ? 'border-[#2E7D32] bg-[#2E7D32] text-white' : 'border-[#E96B2C] bg-[#FFF0DD] text-[#B95620]'") {{step > 1 ? '✓' : '1'}}
                    span(class="text-xs font-extrabold", [ngClass]="step === 1 ? 'text-[#B95620]' : 'text-[#476246]'") 배송 정보
            li(class="relative flex items-center justify-end")
                div(class="absolute left-0 right-7 top-4 h-0.5", [ngClass]="step >= 2 ? 'bg-[#2E7D32]' : 'bg-[#DED2C7]'", aria-hidden="true")
                div(class="relative z-10 flex items-center gap-2 bg-[#F8F5F0] pl-2", [attr.aria-current]="step === 2 ? 'step' : null")
                    span(class="text-xs font-extrabold", [ngClass]="step === 2 ? 'text-[#2E7D32]' : 'text-[#9B8D82]'") 할인 · 결제
                    span(class="flex size-8 items-center justify-center rounded-full border-2 text-xs font-black", [ngClass]="step === 2 ? 'border-[#2E7D32] bg-[#E6F5E8] text-[#2E7D32]' : 'border-[#D7CBC0] bg-[#FFFDF8] text-[#9B8D82]'") 2

    main(*ngIf="step === 1", class="mt-6 space-y-4")
        section(class="rounded-[24px] border border-[#E5D9CE] bg-[#FFFDF8] p-4")
            div
                h2(class="text-base font-extrabold text-[#3D3128]") 어떻게 받을까요?
                p(class="mt-1 text-xs leading-5 text-[#8B7E73]") 배송 또는 홍천중앙시장 픽업을 선택해 주세요.
            div(class="mt-4 grid grid-cols-2 gap-3", role="group", aria-label="받는 방법")
                button(type="button", (click)="selectDelivery('delivery')", class="rounded-2xl border p-3.5 text-left transition", [ngClass]="deliveryMethod === 'delivery' ? 'border-[#E96B2C] bg-[#FFF5E8] shadow-sm' : 'border-[#E3D7CC] bg-white'", [attr.aria-pressed]="deliveryMethod === 'delivery'")
                    div(class="flex items-center justify-between")
                        span(class="text-2xl", aria-hidden="true") 🚚
                        span(class="flex size-5 items-center justify-center rounded-full border-2", [ngClass]="deliveryMethod === 'delivery' ? 'border-[#E96B2C]' : 'border-[#CFC2B7]'")
                            span(*ngIf="deliveryMethod === 'delivery'", class="size-2.5 rounded-full bg-[#E96B2C]")
                    p(class="mt-3 text-sm font-extrabold text-[#3E3229]") 집으로 배송
                    p(class="mt-1 text-[10px] leading-4 text-[#8B7E73]") 버틀러 검수 후 안전하게 보내드려요.
                button(type="button", (click)="selectDelivery('pickup')", class="rounded-2xl border p-3.5 text-left transition", [ngClass]="deliveryMethod === 'pickup' ? 'border-[#2E7D32] bg-[#F2F8F0] shadow-sm' : 'border-[#E3D7CC] bg-white'", [attr.aria-pressed]="deliveryMethod === 'pickup'")
                    div(class="flex items-center justify-between")
                        span(class="text-2xl", aria-hidden="true") 🏪
                        span(class="flex size-5 items-center justify-center rounded-full border-2", [ngClass]="deliveryMethod === 'pickup' ? 'border-[#2E7D32]' : 'border-[#CFC2B7]'")
                            span(*ngIf="deliveryMethod === 'pickup'", class="size-2.5 rounded-full bg-[#2E7D32]")
                    p(class="mt-3 text-sm font-extrabold text-[#3E3229]") 시장에서 픽업
                    p(class="mt-1 text-[10px] leading-4 text-[#8B7E73]") 준비 알림 후 전용 부스에서 찾아가세요.

        section(*ngIf="deliveryMethod === 'delivery'", class="rounded-[24px] border border-[#E5D9CE] bg-[#FFFDF8] p-4")
            h2(class="text-base font-extrabold text-[#3D3128]") 받는 분과 배송지
            p(class="mt-1 text-xs text-[#8B7E73]") 주문 상품을 받을 정보를 입력해 주세요.
            div(class="mt-4 space-y-3")
                div
                    label(for="delivery-name", class="mb-1.5 block text-xs font-bold text-[#5C4E43]") 받는 분
                    input(id="delivery-name", name="delivery-name", type="text", [(ngModel)]="delivery.name", (blur)="saveDraft()", autocomplete="name", placeholder="이름", required="true", class="h-12 w-full rounded-xl border border-[#DED2C7] bg-white px-3 text-sm outline-none focus:border-[#E96B2C] focus:ring-1 focus:ring-[#E96B2C]")
                div
                    label(for="delivery-mobile", class="mb-1.5 block text-xs font-bold text-[#5C4E43]") 연락처
                    input(id="delivery-mobile", name="delivery-mobile", type="tel", [(ngModel)]="delivery.mobile", (blur)="saveDraft()", autocomplete="tel", inputmode="tel", placeholder="010-0000-0000", required="true", class="h-12 w-full rounded-xl border border-[#DED2C7] bg-white px-3 text-sm outline-none focus:border-[#E96B2C] focus:ring-1 focus:ring-[#E96B2C]")
                div
                    label(for="delivery-address", class="mb-1.5 block text-xs font-bold text-[#5C4E43]") 배송 주소
                    textarea(id="delivery-address", name="delivery-address", [(ngModel)]="delivery.address", (blur)="saveDraft()", autocomplete="street-address", placeholder="도로명 주소와 상세 주소를 입력하세요", required="true", rows="2", class="min-h-20 w-full resize-none rounded-xl border border-[#DED2C7] bg-white px-3 py-3 text-sm outline-none focus:border-[#E96B2C] focus:ring-1 focus:ring-[#E96B2C]")
                div
                    label(for="delivery-memo", class="mb-1.5 block text-xs font-bold text-[#5C4E43]") 배송 메모
                    input(id="delivery-memo", name="delivery-memo", type="text", [(ngModel)]="delivery.memo", (blur)="saveDraft()", placeholder="예: 문 앞에 놓아주세요", class="h-12 w-full rounded-xl border border-[#DED2C7] bg-white px-3 text-sm outline-none focus:border-[#E96B2C] focus:ring-1 focus:ring-[#E96B2C]")
            button(type="button", (click)="toggleRememberDelivery()", class="mt-3 flex min-h-11 w-full items-center gap-2 rounded-xl bg-[#F5EEE7] px-3 text-left", [attr.aria-pressed]="rememberDelivery")
                span(class="flex size-5 items-center justify-center rounded-md border text-xs font-black", [ngClass]="rememberDelivery ? 'border-[#2E7D32] bg-[#2E7D32] text-white' : 'border-[#CBBEB3] bg-white'") {{rememberDelivery ? '✓' : ''}}
                span(class="text-xs font-bold text-[#594A3F]") 이 배송지를 다음 주문에도 사용

        section(*ngIf="deliveryMethod === 'pickup'", class="rounded-[24px] border border-[#C7E7CC] bg-[#F7FBF5] p-4")
            h2(class="text-base font-extrabold text-[#3D503A]") 픽업 시간
            label(for="pickup-slot", class="mt-4 mb-1.5 block text-xs font-bold text-[#5C4E43]") 희망 픽업 시간
            select(id="pickup-slot", name="pickup-slot", [(ngModel)]="pickupSlot", (change)="saveDraft()", class="h-12 w-full rounded-xl border border-[#C9DCC8] bg-white px-3 text-sm outline-none focus:border-[#2E7D32] focus:ring-1 focus:ring-[#2E7D32]")
                option(value="오늘 16:00 ~ 17:00") 오늘 16:00 ~ 17:00
                option(value="오늘 17:00 ~ 18:00") 오늘 17:00 ~ 18:00
                option(value="내일 10:00 ~ 11:00") 내일 10:00 ~ 11:00
            div(class="mt-3 rounded-xl bg-[#E8F4E7] px-3 py-3 text-xs leading-5 text-[#4C654C]") 홍천중앙시장 고객지원센터 앞 ‘마켓 버틀러’ 픽업 부스에서 주문번호를 보여주세요.

        section(class="flex items-center justify-between rounded-[20px] border border-[#E5D9CE] bg-[#FFFDF8] p-4")
            div
                p(class="text-xs font-bold text-[#8B7E73]") 주문 상품
                p(class="mt-1 text-sm font-extrabold text-[#3E3229]") {{itemCount}}개 · {{cartItems.length}}종
            p(class="text-lg font-black text-[#E96B2C]") {{subtotal | number}}원

    main(*ngIf="step === 2", class="mt-6 space-y-4")
        section(class="rounded-[22px] border border-[#C7E7CC] bg-[#F7FBF5] p-4")
            div(class="flex items-start justify-between gap-3")
                div(class="min-w-0")
                    p(class="text-[10px] font-extrabold uppercase tracking-[0.12em] text-[#2E7D32]") 받는 방법
                    h2(class="mt-1 text-sm font-extrabold text-[#354E36]") {{deliveryTitle}}
                    p(class="mt-1 truncate text-xs text-[#667765]") {{deliveryDescription}}
                    p(*ngIf="deliveryMethod === 'delivery'", class="mt-1 text-[10px] text-[#7C8B79]") {{delivery.name}} · {{delivery.mobile}}
                button(type="button", (click)="goToDelivery()", class="shrink-0 rounded-lg border border-[#BFD6BE] bg-white px-3 py-2 text-[11px] font-extrabold text-[#2E7D32]") 수정

        fieldset(class="rounded-[24px] border border-[#E5D9CE] bg-[#FFFDF8] p-4")
            legend(class="px-1 text-base font-extrabold text-[#3D3128]") 쿠폰 선택
            p(class="mt-1 text-xs text-[#8B7E73]") 한 주문에 쿠폰 하나를 사용할 수 있어요.
            div(class="mt-4 space-y-2")
                button(*ngFor="let coupon of coupons", type="button", (click)="selectCoupon(coupon)", [disabled]="!couponAvailable(coupon)", class="flex min-h-[72px] w-full items-center gap-3 rounded-2xl border p-3 text-left transition disabled:cursor-not-allowed disabled:opacity-45", [ngClass]="selectedCouponId === coupon.id ? 'border-[#E96B2C] bg-[#FFF5E8]' : 'border-[#E5D9CE] bg-white'", [attr.aria-pressed]="selectedCouponId === coupon.id")
                    span(class="flex size-5 shrink-0 items-center justify-center rounded-full border-2", [ngClass]="selectedCouponId === coupon.id ? 'border-[#E96B2C]' : 'border-[#CFC2B7]'")
                        span(*ngIf="selectedCouponId === coupon.id", class="size-2.5 rounded-full bg-[#E96B2C]")
                    span(class="min-w-0 flex-1")
                        span(class="flex items-center gap-2")
                            span(class="truncate text-xs font-extrabold text-[#3E3229]") {{coupon.title}}
                            span(*ngIf="coupon.badge", class="shrink-0 rounded-full bg-[#FFE6C9] px-2 py-0.5 text-[9px] font-extrabold text-[#A95625]") {{coupon.badge}}
                        span(class="mt-1 block text-[10px] leading-4 text-[#8B7E73]") {{coupon.description}}
                    span(*ngIf="coupon.id !== 'none' && couponAvailable(coupon)", class="shrink-0 text-xs font-black text-[#E96B2C]") -{{couponAmount(coupon) | number}}원
                    span(*ngIf="!couponAvailable(coupon)", class="shrink-0 text-[10px] font-extrabold text-[#9A8D82]") 사용 불가

            button(type="button", (click)="togglePoints()", class="mt-3 flex min-h-[58px] w-full items-center justify-between rounded-2xl bg-[#F5EEE7] px-3.5 py-3 text-left", [attr.aria-pressed]="usePoints")
                span
                    span(class="block text-xs font-extrabold text-[#594A3F]") 보유 포인트 1,200P
                    span(*ngIf="usePoints", class="mt-0.5 block text-[10px] text-[#8B7E73]") {{pointDiscount | number}}P 사용
                    span(*ngIf="!usePoints", class="mt-0.5 block text-[10px] text-[#8B7E73]") 사용하지 않음
                span(class="flex size-5 items-center justify-center rounded-md border text-xs font-black", [ngClass]="usePoints ? 'border-[#2E7D32] bg-[#2E7D32] text-white' : 'border-[#CBBEB3] bg-white'") {{usePoints ? '✓' : ''}}

        fieldset(class="rounded-[24px] border border-[#E5D9CE] bg-[#FFFDF8] p-4")
            legend(class="px-1 text-base font-extrabold text-[#3D3128]") 결제 수단
            p(class="mt-1 text-xs text-[#8B7E73]") 지역상품권을 포함한 결제 화면 시연용 UI입니다.
            div(class="mt-4 space-y-2")
                button(*ngFor="let method of paymentMethods", type="button", (click)="selectPayment(method.id)", class="flex min-h-[64px] w-full items-center gap-3 rounded-2xl border p-3 text-left transition", [ngClass]="paymentMethod === method.id ? 'border-[#2E7D32] bg-[#F2F8F0]' : 'border-[#E5D9CE] bg-white'", [attr.aria-pressed]="paymentMethod === method.id")
                    span(class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#F5EEE7] text-lg font-black text-[#5B4D42]", aria-hidden="true") {{method.icon}}
                    span(class="min-w-0 flex-1")
                        span(class="flex items-center gap-1.5")
                            span(class="block truncate text-xs font-extrabold text-[#3E3229]") {{method.label}}
                            span(*ngIf="method.badge", class="shrink-0 rounded-full bg-[#FFF0DD] px-2 py-0.5 text-[8px] font-black text-[#B95620]") {{method.badge}}
                        span(class="mt-1 block text-[10px] text-[#8B7E73]") {{method.description}}
                    span(class="flex size-5 shrink-0 items-center justify-center rounded-full border-2", [ngClass]="paymentMethod === method.id ? 'border-[#2E7D32]' : 'border-[#CFC2B7]'")
                        span(*ngIf="paymentMethod === method.id", class="size-2.5 rounded-full bg-[#2E7D32]")

            div(*ngIf="isPaymentPrototype", class="mt-3 rounded-2xl border border-[#C7E7CC] bg-[#F2F8F0] p-3.5")
                div(class="flex items-center justify-between gap-2")
                    p(class="text-xs font-black text-[#315A32]") 상품권 결제 클립
                    span(class="rounded-full bg-white px-2 py-1 text-[8px] font-black text-[#2E7D32]") API 연동 예정
                div(class="mt-3 grid grid-cols-3 gap-2 text-center")
                    div(class="rounded-xl bg-white px-2 py-2")
                        p(class="text-lg") 1
                        p(class="text-[9px] font-bold text-[#647861]") 상품권 선택
                    div(class="rounded-xl bg-white px-2 py-2")
                        p(class="text-lg") 2
                        p(class="text-[9px] font-bold text-[#647861]") 충전·인증
                    div(class="rounded-xl bg-white px-2 py-2")
                        p(class="text-lg") 3
                        p(class="text-[9px] font-bold text-[#647861]") 결제 완료
                p(class="mt-3 text-[9px] leading-4 text-[#71806F]") 상품권 구매 할인율과 한도는 발행기관 정책에 따라 충전 단계에서 적용됩니다. 현재 화면에서는 실제 충전·결제가 발생하지 않습니다.

        section(class="rounded-[24px] border border-[#E1D4C8] bg-[#FFFDF8] p-4 shadow-[0_14px_38px_rgba(65,45,30,0.07)]")
            h2(class="text-base font-extrabold text-[#3D3128]") 최종 결제 금액
            dl(class="mt-4 space-y-2.5 text-xs")
                div(class="flex justify-between")
                    dt(class="text-[#7D6E63]") 상품 금액
                    dd(class="font-bold text-[#43372E]") {{subtotal | number}}원
                div(class="flex justify-between")
                    dt(class="text-[#7D6E63]") {{deliveryMethod === 'delivery' ? '버틀러 배송비' : '픽업 비용'}}
                    dd(class="font-bold text-[#43372E]") {{shippingFee | number}}원
                div(*ngIf="couponDiscount > 0", class="flex justify-between text-[#2E7D32]")
                    dt {{selectedCouponLabel}}
                    dd(class="font-bold") -{{couponDiscount | number}}원
                div(*ngIf="pointDiscount > 0", class="flex justify-between text-[#2E7D32]")
                    dt 포인트 사용
                    dd(class="font-bold") -{{pointDiscount | number}}원
            div(class="my-4 h-px bg-[#E8DDD3]")
            div(class="flex items-end justify-between")
                p(class="text-sm font-extrabold text-[#493C33]") 결제 금액
                p(class="text-2xl font-black tracking-[-0.03em] text-[#E96B2C]") {{total | number}}원
            p(class="mt-3 text-[10px] leading-4 text-[#9A8D82]") 결제 후 품절·대체로 금액이 달라지면 버틀러가 차액을 안내해 드립니다.

    div(*ngIf="step === 1", class="checkout-action-dock")
        div(class="flex w-full gap-2 rounded-[20px] border border-[#E4D7CB] bg-[#FFFDF8]/95 p-2 shadow-[0_14px_38px_rgba(63,43,28,0.20)] backdrop-blur")
            button(type="button", (click)="back()", class="h-[52px] w-24 shrink-0 rounded-2xl border border-[#D9CCC1] bg-white text-xs font-extrabold text-[#5B4D42]") 장바구니
            button(type="button", (click)="goToPayment()", class="flex h-[52px] flex-1 items-center justify-center gap-1.5 rounded-2xl bg-[#E96B2C] px-4 text-sm font-extrabold text-white")
                span 다음
                svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", class="size-4", aria-hidden="true")
                    path(d="m9 5 7 7-7 7", stroke-linecap="round", stroke-linejoin="round")

    div(*ngIf="step === 2", class="checkout-action-dock")
        div(class="flex w-full gap-2 rounded-[20px] border border-[#E4D7CB] bg-[#FFFDF8]/95 p-2 shadow-[0_14px_38px_rgba(63,43,28,0.20)] backdrop-blur")
            button(type="button", (click)="goToDelivery()", [disabled]="processing", class="h-[52px] w-20 shrink-0 rounded-2xl border border-[#D9CCC1] bg-white text-xs font-extrabold text-[#5B4D42] disabled:opacity-50") 이전
            button(type="button", (click)="checkout()", [disabled]="processing", [attr.aria-busy]="processing", class="flex h-[52px] flex-1 items-center justify-center gap-2 rounded-2xl bg-[#E96B2C] px-4 text-sm font-extrabold text-white disabled:cursor-wait disabled:opacity-60")
                svg(*ngIf="processing", class="size-4 animate-spin", viewBox="0 0 24 24", fill="none", aria-hidden="true")
                    circle(cx="12", cy="12", r="9", stroke="currentColor", stroke-width="3", opacity=".25")
                    path(d="M21 12a9 9 0 0 0-9-9", stroke="currentColor", stroke-width="3", stroke-linecap="round")
                span(*ngIf="processing") 결제 처리 중...
                span(*ngIf="!processing") {{checkoutButtonLabel}}
