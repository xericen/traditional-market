main(class="min-h-full bg-[#FFF8EF] text-[#2F241D]")
    section(class="access-mobile-hero relative overflow-hidden px-6 pb-12 pt-7 text-white")
        div(class="relative z-10 flex items-center justify-between")
            button(type="button", (click)="goMode('login')", class="flex items-center gap-2.5 text-left")
                span(class="flex size-10 items-center justify-center rounded-[15px] bg-white/15 ring-1 ring-white/25 backdrop-blur")
                    svg(viewBox="0 0 32 32", fill="none", class="size-6", aria-hidden="true")
                        path(d="M8 12v15m16-15v15M5 12h22l-2.4-6H7.4L5 12Z", stroke="currentColor", stroke-width="2.2", stroke-linejoin="round")
                        path(d="M12 27v-7h8v7", stroke="currentColor", stroke-width="2.2")
                span
                    span(class="block text-[17px] font-black leading-none tracking-[-0.03em]") 홍천장날
                    span(class="mt-1 block text-[9px] font-extrabold uppercase tracking-[0.18em] text-white/65") Market Butler
            span(class="rounded-full bg-white/15 px-2.5 py-1 text-[9px] font-bold ring-1 ring-white/20") 홍천중앙시장

        div(class="relative z-10 mt-8 max-w-[290px]")
            p(class="text-[11px] font-extrabold text-[#FFE2BD]") 오늘의 시장을 내 손안에
            h1(*ngIf="mode === 'login'", class="mt-2 text-[29px] font-black leading-[1.16] tracking-[-0.05em]")
                | 만나서
                br
                span(class="text-[#FFD39F]") 반갑습니다.
            h1(*ngIf="mode === 'signup'", class="mt-2 text-[29px] font-black leading-[1.16] tracking-[-0.05em]")
                | 시장과 이어지는
                br
                span(class="text-[#FFD39F]") 첫걸음이에요.
            p(*ngIf="mode === 'login'", class="mt-3 text-xs leading-5 text-white/70") 로그인하면 계정에 맞는 전용 화면으로 바로 안내해 드려요.
            p(*ngIf="mode === 'signup'", class="mt-3 text-xs leading-5 text-white/70") 마켓 버틀러, 상인 또는 소비자 계정으로 홍천장날을 시작해 보세요.

        div(class="absolute -bottom-8 -right-5 rotate-[-7deg] text-[112px] drop-shadow-[0_20px_20px_rgba(28,18,10,0.25)]") 🧺
        div(class="absolute bottom-7 right-4 rounded-xl bg-[#F28C28] px-3 py-2 text-[9px] font-black shadow-lg") 믿고 고르는 오늘의 시장

    section(class="relative z-10 -mt-6 px-4 pb-8")
        div(class="rounded-[26px] border border-[#E9DED4] bg-white p-5 shadow-[0_18px_50px_rgba(77,54,37,0.12)]")
            div(class="flex rounded-2xl bg-[#F5EFE9] p-1", role="tablist", aria-label="계정 시작 메뉴")
                button(type="button", role="tab", [attr.aria-selected]="mode === 'login'", [class]="modeTabClass('login')", (click)="goMode('login')") 로그인
                button(type="button", role="tab", [attr.aria-selected]="mode === 'signup'", [class]="modeTabClass('signup')", (click)="goMode('signup')") 회원가입

            div(*ngIf="mode === 'login'", class="mt-5 space-y-3")
                div
                    label(for="login-identifier", class="mb-1.5 block text-[11px] font-extrabold text-[#5C4D42]") 아이디
                    div(class="relative")
                        svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", class="pointer-events-none absolute left-3.5 top-1/2 size-[18px] -translate-y-1/2 text-[#A5978B]")
                            circle(cx="12", cy="8", r="4")
                            path(d="M4.5 20a7.5 7.5 0 0 1 15 0", stroke-linecap="round")
                        input(id="login-identifier", type="text", autocomplete="username", [(ngModel)]="loginData.identifier", (keyup.enter)="login()", placeholder="아이디를 입력하세요", class="h-11 w-full rounded-xl border border-[#DDD1C6] bg-[#FFFDF8] py-2.5 pl-10 pr-3 text-xs text-[#2F241D] placeholder:text-[#AA9D91] focus:border-[#2E7D32] focus:ring-2 focus:ring-[#2E7D32]/15")

                div
                    div(class="mb-1.5 flex items-center justify-between")
                        label(for="login-password", class="text-[11px] font-extrabold text-[#5C4D42]") 비밀번호
                        span(class="text-[9px] font-semibold text-[#9A8D82]") 계정별 전용 화면으로 이동
                    div(class="relative")
                        svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", class="pointer-events-none absolute left-3.5 top-1/2 size-[18px] -translate-y-1/2 text-[#A5978B]")
                            rect(x="4", y="10", width="16", height="11", rx="2")
                            path(d="M8 10V7a4 4 0 0 1 8 0v3")
                        input(id="login-password", [type]="showPassword ? 'text' : 'password'", autocomplete="current-password", [(ngModel)]="loginData.password", (keyup.enter)="login()", placeholder="비밀번호를 입력하세요", class="h-11 w-full rounded-xl border border-[#DDD1C6] bg-[#FFFDF8] py-2.5 pl-10 pr-11 text-xs text-[#2F241D] placeholder:text-[#AA9D91] focus:border-[#2E7D32] focus:ring-2 focus:ring-[#2E7D32]/15")
                        button(type="button", (click)="togglePassword()", class="absolute right-2.5 top-1/2 -translate-y-1/2 rounded-lg p-1.5 text-[#8B7E73]", [attr.aria-label]="showPassword ? '비밀번호 숨기기' : '비밀번호 보기'")
                            svg(*ngIf="!showPassword", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", class="size-4")
                                path(d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z")
                                circle(cx="12", cy="12", r="2.5")
                            svg(*ngIf="showPassword", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.7", class="size-4")
                                path(d="m4 4 16 16M10.6 6.2A9 9 0 0 1 12 6c6 0 9.5 6 9.5 6a16 16 0 0 1-2.1 2.7M6.1 6.1C3.8 7.7 2.5 12 2.5 12s3.5 6 9.5 6a9 9 0 0 0 3-.5M9.8 9.8a3 3 0 0 0 4.4 4.4")

                p(*ngIf="errorMessage", role="alert", aria-live="polite", class="rounded-xl bg-[#FFF1ED] px-3 py-2 text-[10px] font-bold leading-4 text-[#C9492C]") {{errorMessage}}

                button(type="button", (click)="login()", [disabled]="loading", [attr.aria-busy]="loading", class="flex h-11 w-full items-center justify-center gap-2 rounded-xl bg-[#2E7D32] text-xs font-black text-white transition disabled:opacity-60")
                    svg(*ngIf="loading", class="size-4 animate-spin", viewBox="0 0 24 24", fill="none")
                        circle(cx="12", cy="12", r="9", stroke="currentColor", stroke-width="3", opacity=".25")
                        path(d="M21 12a9 9 0 0 0-9-9", stroke="currentColor", stroke-width="3", stroke-linecap="round")
                    span {{loading ? '확인 중...' : '로그인'}}

                p(class="text-center text-[9px] text-[#918478]")
                    | 처음 오셨나요?
                    button(type="button", (click)="goMode('signup')", class="ml-1 font-black text-[#C35F27]") 회원가입

            div(*ngIf="mode === 'signup'", class="mt-5 space-y-3")
                fieldset
                    legend(class="mb-1.5 block text-[11px] font-extrabold text-[#5C4D42]") 가입 유형
                    div(class="grid grid-cols-2 gap-2")
                        label(*ngFor="let role of signupRoles", [class]="signupRoleClass(role.value)")
                            input(type="radio", name="signup-role", [value]="role.value", [(ngModel)]="signupData.role", (change)="selectSignupRole(role.value)", class="sr-only")
                            span(class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-white text-base shadow-sm") {{role.icon}}
                            span(class="min-w-0 text-left")
                                span(class="block text-[11px] font-black text-[#315132]") {{role.label}}
                                span(class="mt-0.5 block text-[8px] leading-3 text-[#71806F]") {{role.description}}
                            span(*ngIf="signupData.role === role.value", class="absolute right-1.5 top-1.5 flex size-3.5 items-center justify-center rounded-full bg-[#2E7D32] text-[8px] font-black text-white", aria-hidden="true") ✓

                div(class="grid grid-cols-2 gap-2")
                    div
                        label(for="signup-name", class="mb-1.5 block text-[11px] font-extrabold text-[#5C4D42]") 이름
                        input(id="signup-name", type="text", autocomplete="name", [(ngModel)]="signupData.name", placeholder="이름", class="h-11 w-full rounded-xl border border-[#DDD1C6] bg-[#FFFDF8] px-3 text-xs focus:border-[#2E7D32] focus:ring-2 focus:ring-[#2E7D32]/15")
                    div
                        label(for="signup-mobile", class="mb-1.5 block text-[11px] font-extrabold text-[#5C4D42]") 연락처
                            span(class="ml-1 font-medium text-[#A09287]") 선택
                        input(id="signup-mobile", type="tel", autocomplete="tel", [(ngModel)]="signupData.mobile", placeholder="010-0000-0000", class="h-11 w-full rounded-xl border border-[#DDD1C6] bg-[#FFFDF8] px-3 text-xs focus:border-[#2E7D32] focus:ring-2 focus:ring-[#2E7D32]/15")

                div
                    label(for="signup-identifier", class="mb-1.5 block text-[11px] font-extrabold text-[#5C4D42]") 아이디
                    input(id="signup-identifier", type="text", autocomplete="username", [(ngModel)]="signupData.identifier", placeholder="영문·숫자 3~32자", class="h-11 w-full rounded-xl border border-[#DDD1C6] bg-[#FFFDF8] px-3 text-xs focus:border-[#2E7D32] focus:ring-2 focus:ring-[#2E7D32]/15")

                div(class="grid grid-cols-2 gap-2")
                    div
                        label(for="signup-password", class="mb-1.5 block text-[11px] font-extrabold text-[#5C4D42]") 비밀번호
                        input(id="signup-password", [type]="showPassword ? 'text' : 'password'", autocomplete="new-password", [(ngModel)]="signupData.password", placeholder="8자 이상", class="h-11 w-full rounded-xl border border-[#DDD1C6] bg-[#FFFDF8] px-3 text-xs focus:border-[#2E7D32] focus:ring-2 focus:ring-[#2E7D32]/15")
                    div
                        div(class="mb-1.5 flex items-center justify-between")
                            label(for="signup-password-confirm", class="text-[11px] font-extrabold text-[#5C4D42]") 비밀번호 확인
                            button(type="button", (click)="togglePassword()", class="text-[9px] font-bold text-[#8B7E73]") {{showPassword ? '숨기기' : '보기'}}
                        input(id="signup-password-confirm", [type]="showPassword ? 'text' : 'password'", autocomplete="new-password", [(ngModel)]="signupData.passwordConfirm", (keyup.enter)="signup()", placeholder="한 번 더 입력", class="h-11 w-full rounded-xl border border-[#DDD1C6] bg-[#FFFDF8] px-3 text-xs focus:border-[#2E7D32] focus:ring-2 focus:ring-[#2E7D32]/15")

                p(class="rounded-xl bg-[#F5F8F2] px-3 py-2 text-[9px] leading-4 text-[#697766]") 마켓 버틀러는 가입 신청 후 홍천상인회 승인이 필요해요. 승인 전에는 운영 화면과 주문 정보에 접근할 수 없습니다.
                p(*ngIf="errorMessage", role="alert", aria-live="polite", class="rounded-xl bg-[#FFF1ED] px-3 py-2 text-[10px] font-bold leading-4 text-[#C9492C]") {{errorMessage}}

                button(type="button", (click)="signup()", [disabled]="loading", [attr.aria-busy]="loading", class="flex h-11 w-full items-center justify-center gap-2 rounded-xl bg-[#E96B2C] text-xs font-black text-white transition disabled:opacity-60")
                    svg(*ngIf="loading", class="size-4 animate-spin", viewBox="0 0 24 24", fill="none")
                        circle(cx="12", cy="12", r="9", stroke="currentColor", stroke-width="3", opacity=".25")
                        path(d="M21 12a9 9 0 0 0-9-9", stroke="currentColor", stroke-width="3", stroke-linecap="round")
                    span {{loading ? '계정 만드는 중...' : signupButtonLabel()}}

                p(class="text-center text-[9px] text-[#918478]")
                    | 이미 계정이 있나요?
                    button(type="button", (click)="goMode('login')", class="ml-1 font-black text-[#2E7D32]") 로그인

        p(class="mt-4 text-center text-[9px] leading-4 text-[#918478]") 홍천중앙시장 상인회가 현장 등록과 검수를 지원합니다.
