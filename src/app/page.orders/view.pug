div(class="mx-auto w-full max-w-7xl px-4 py-6    ")
    header(class="flex flex-col gap-3   ")
        div
            p(class="text-xs font-extrabold uppercase tracking-[0.16em] text-[#2E7D32]") Butler tracking
            h1(class="mt-1 text-3xl font-black tracking-[-0.04em] text-[#2F241D]") 내 주문
            p(class="mt-2 text-sm text-[#7B6D62]") 주문 접수부터 현장 검수, 배송·픽업까지 버틀러가 알려드려요.
        a(routerLink="/posts", class="inline-flex h-11 items-center justify-center self-start rounded-xl border border-[#E2D6CB] bg-white px-4 text-xs font-extrabold text-[#594B40]") 오늘 상품 더 보기

    div(*ngIf="showPlaced", class="mt-6 flex items-start gap-3 rounded-[20px] border border-[#C7E7CC] bg-[#EFF8F0] p-4 text-[#315A32]")
        span(class="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-[#2E7D32] text-lg text-white") ✓
        div
            p(class="text-sm font-extrabold") 결제와 주문 접수가 완료됐어요.
            p(class="mt-1 text-xs leading-5 text-[#647861]") 버틀러가 현장에서 상품을 확인하고 다음 진행을 알려드릴게요.

    div(*ngIf="orders.length === 0", class="mt-8 flex min-h-[440px] flex-col items-center justify-center rounded-[28px] border border-dashed border-[#D9CCC1] bg-[#FFFDF8] px-6 text-center")
        span(class="text-6xl") 📦
        h2(class="mt-5 text-xl font-black") 아직 주문한 상품이 없어요.
        p(class="mt-2 text-sm text-[#85776C]") 오늘의 시장에서 장보기를 시작해 보세요.
        a(routerLink="/posts", class="mt-5 h-11 rounded-xl bg-[#E96B2C] px-5 py-3 text-sm font-extrabold text-white") 장보기 시작

    div(*ngIf="selectedOrder", class="mt-7 grid gap-5  ")
        main(class="space-y-5")
            section(class="overflow-hidden rounded-[26px] border border-[#E2D6CB] bg-[#FFFDF8] shadow-[0_16px_45px_rgba(67,47,32,0.07)]")
                div(class="flex flex-col gap-3 border-b border-[#ECE2D9] px-5 py-5    ")
                    div
                        div(class="flex flex-wrap items-center gap-2")
                            span([class]="statusClass(selectedOrder.status)") {{statusLabel(selectedOrder.status)}}
                            span(*ngIf="selectedOrder.isDemo", class="rounded-full bg-[#F4EAFB] px-2.5 py-1 text-[10px] font-extrabold text-[#72519A]") 체험 주문
                        h2(class="mt-2 text-xl font-black tracking-[-0.03em] text-[#342A23]") 주문 {{selectedOrder.id}}
                        p(class="mt-1 text-xs text-[#8B7E73]") {{formatDate(selectedOrder.created)}} · {{selectedOrder.method === 'pickup' ? '시장 픽업' : '집으로 배송'}}
                    button(*ngIf="selectedOrder.status === 'received' && !selectedOrder.isDemo", type="button", (click)="cancelOrder()", class="self-start text-xs font-bold text-[#A9674D] hover:text-[#C9492C]") 주문 취소

                div(class="px-4 py-6  ")
                    div(class="relative grid grid-cols-4")
                        div(class="absolute left-[12.5%] right-[12.5%] top-5 h-0.5 bg-[#E1D6CC]")
                        div(class="absolute left-[12.5%] top-5 h-0.5 bg-[#2E7D32] transition-all duration-500", [style.width]="progressWidth()")
                        div(*ngFor="let step of steps; let i = index", class="relative z-10 flex flex-col items-center px-1 text-center")
                            div(class="flex size-10 items-center justify-center rounded-full border-2 text-xs font-black transition", [ngClass]="stepCircleClass(i)")
                                span(*ngIf="isStepDone(i)") ✓
                                span(*ngIf="!isStepDone(i)") {{i + 1}}
                            p(class="mt-2 text-[10px] font-extrabold leading-4 ", [ngClass]="i <= currentStep() ? 'text-[#315A32]' : 'text-[#9B8E83]'") {{step.label}}
                            p(class="mt-0.5 hidden text-[9px] text-[#9B8E83] ") {{step.hint}}

                    div(class="mt-7 rounded-2xl border p-4", [ngClass]="selectedOrder.status === 'inspecting' ? 'border-[#C7E7CC] bg-[#F2F8F0]' : 'border-[#E5D9CE] bg-[#F8F5F0]'")
                        div(class="flex items-start gap-3")
                            span(class="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-[#2E7D32] text-sm font-black text-white") B
                            div
                                p(class="text-xs font-extrabold text-[#365D36]") {{selectedOrder.butler || '김민서 버틀러'}}
                                p(class="mt-1 text-sm font-bold leading-6 text-[#455342]") {{butlerMessage()}}
                                p(class="mt-1 text-[10px] text-[#758472]") 홍천중앙시장 현장에서 보냄

            section(class="grid gap-5 ")
                article(class="rounded-[24px] border border-[#E5D9CE] bg-[#FFFDF8] p-5")
                    div(class="flex items-center justify-between")
                        h2(class="text-base font-extrabold text-[#3D3128]") 주문 상품
                        span(class="text-xs font-semibold text-[#8B7E73]") 총 {{itemCount(selectedOrder)}}개
                    div(class="mt-4 divide-y divide-[#EEE4DB]")
                        div(*ngFor="let item of selectedOrder.items", class="flex gap-3 py-3 first:pt-0 last:pb-0")
                            div(class="flex size-16 shrink-0 items-center justify-center rounded-2xl text-3xl", [ngClass]="item.bg") {{item.emoji}}
                            div(class="min-w-0 flex-1")
                                p(class="truncate text-[10px] font-semibold text-[#8B7E73]") {{item.shop}}
                                p(class="mt-1 text-xs font-extrabold text-[#3E3229] ") {{item.name}}
                                p(class="mt-1 text-[11px] text-[#74665B]") {{item.price | number}}원 × {{item.quantity}}
                            p(class="self-center text-xs font-black text-[#3E3229]") {{item.price * item.quantity | number}}원

                article(class="rounded-[24px] border border-[#C7E7CC] bg-[#F7FBF5] p-5")
                    div(class="flex items-center justify-between")
                        h2(class="text-base font-extrabold text-[#3D503A]") 현장 검수 기록
                        span(class="rounded-full bg-[#DFF3E2] px-2 py-1 text-[9px] font-extrabold text-[#2E7D32]") BUTLER CHECK
                    div(class="mt-4 grid grid-cols-2 gap-2")
                        div(*ngFor="let check of inspectionChecks; let i = index", class="flex items-center gap-2 rounded-xl bg-white px-3 py-2.5")
                            span(class="flex size-5 shrink-0 items-center justify-center rounded-full text-[9px] font-black", [ngClass]="i < inspectionDoneCount() ? 'bg-[#2E7D32] text-white' : 'bg-[#ECE6DF] text-[#9A8D82]'") {{i < inspectionDoneCount() ? '✓' : '·'}}
                            span(class="text-[10px] font-bold", [ngClass]="i < inspectionDoneCount() ? 'text-[#476246]' : 'text-[#93867B]'") {{check}}
                    div(class="inspection-preview mt-4 flex min-h-28 items-center justify-center rounded-2xl text-center")
                        div
                            span(class="text-4xl") 📹
                            p(class="mt-2 text-[10px] font-extrabold text-white") 검수 영상은 준비 완료 후 열립니다

            section(class="grid gap-5 ")
                article(class="rounded-[24px] border border-[#E5D9CE] bg-[#FFFDF8] p-5")
                    h2(class="text-base font-extrabold text-[#3D3128]") 받는 방법
                    div(class="mt-4 flex items-start gap-3")
                        span(class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-[#E6F0FF] text-xl") {{selectedOrder.method === 'pickup' ? '🏪' : '🚚'}}
                        div
                            p(class="text-sm font-extrabold") {{selectedOrder.method === 'pickup' ? '홍천중앙시장 픽업' : '집으로 배송'}}
                            p(class="mt-1 text-xs leading-5 text-[#817368]")
                                span(*ngIf="selectedOrder.method === 'pickup'") {{selectedOrder.pickupSlot}} · 마켓 버틀러 픽업 부스
                                span(*ngIf="selectedOrder.method !== 'pickup'") {{selectedOrder.delivery?.address || '서울시 마포구 월드컵로 12'}}
                    div(*ngIf="selectedOrder.status === 'ready'", class="mt-4 rounded-xl bg-[#FFF5E8] px-3 py-2.5 text-xs font-bold text-[#A95625]") 준비가 끝났어요. 곧 배송 또는 픽업 안내를 보내드립니다.

                article(class="rounded-[24px] border border-[#E5D9CE] bg-[#FFFDF8] p-5")
                    h2(class="text-base font-extrabold text-[#3D3128]") 결제 정보
                    dl(class="mt-4 space-y-2.5 text-xs")
                        div(*ngIf="selectedOrder.paymentLabel", class="flex justify-between")
                            dt(class="text-[#817368]") 결제 수단
                            dd(class="font-bold") {{selectedOrder.paymentLabel}}
                        div(class="flex justify-between")
                            dt(class="text-[#817368]") 상품 금액
                            dd(class="font-bold") {{selectedOrder.subtotal | number}}원
                        div(class="flex justify-between")
                            dt(class="text-[#817368]") 배송 · 픽업
                            dd(class="font-bold") {{selectedOrder.shippingFee | number}}원
                        div(*ngIf="selectedOrder.discount > 0", class="flex justify-between text-[#2E7D32]")
                            dt 할인
                            dd(class="font-bold") -{{selectedOrder.discount | number}}원
                        div(class="mt-3 flex justify-between border-t border-[#EAE0D7] pt-3")
                            dt(class="font-extrabold") {{selectedOrder.paymentStatus === 'paid' ? '결제 완료' : '결제 예정'}}
                            dd(class="text-sm font-black text-[#E96B2C]") {{selectedOrder.total | number}}원
                    p(*ngIf="selectedOrder.paymentStatus === 'paid'", class="mt-3 text-[10px] leading-4 text-[#657761]") 결제가 완료되었습니다. 품절·대체로 금액이 바뀌면 차액을 별도로 안내해 드려요.
                    p(*ngIf="selectedOrder.paymentStatus !== 'paid'", class="mt-3 text-[10px] leading-4 text-[#9A8D82]") 현장 검수와 대체상품 승인이 끝나면 최종 금액으로 결제됩니다.

            div(class="flex flex-wrap justify-end gap-2 pb-2")
                button(type="button", (click)="contactButler()", class="h-11 rounded-xl border border-[#D9CCC1] bg-white px-4 text-xs font-extrabold text-[#5B4D42]") 버틀러에게 문의
                button(type="button", (click)="reorder()", class="h-11 rounded-xl bg-[#2F241D] px-4 text-xs font-extrabold text-white") 같은 상품 다시 담기

        aside(class="rounded-[24px] border border-[#E2D6CB] bg-[#FFFDF8] p-4  ")
            div(class="flex items-center justify-between px-1")
                h2(class="text-base font-extrabold text-[#3D3128]") 주문 목록
                span(class="text-[10px] font-bold text-[#8B7E73]") 최근 {{orders.length}}건
            div(class="mt-3 space-y-2")
                button(*ngFor="let order of orders", type="button", (click)="selectOrder(order)", class="w-full rounded-2xl border p-3.5 text-left transition", [ngClass]="selectedOrder.id === order.id ? 'border-[#F1B46F] bg-[#FFF5E8]' : 'border-[#E8DED5] bg-white hover:bg-[#FAF7F3]'")
                    div(class="flex items-center justify-between gap-2")
                        span([class]="statusClass(order.status)") {{statusLabel(order.status)}}
                        span(class="text-[9px] text-[#9A8D82]") {{shortDate(order.created)}}
                    p(class="mt-2 text-xs font-extrabold text-[#45382F]") {{order.items[0]?.name}}
                        span(*ngIf="order.items.length > 1", class="font-semibold text-[#8B7E73]") 외 {{order.items.length - 1}}개
                    p(class="mt-1 text-sm font-black text-[#342A23]") {{order.total | number}}원
