div(class="min-h-full bg-[#F3F6F1]")
    header(class="border-b border-[#D8E3D5] bg-[#234E29] px-4 py-5 text-white")
        div(class="mx-auto flex max-w-5xl items-center justify-between gap-3")
            div
                p(class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-[#BFD7BF]") RBAC account control
                h1(class="mt-1 text-xl font-black") 관리자 계정 · 권한 관리
                p(class="mt-1 text-[10px] text-[#C9DCC9]") 총괄관리자만 계정 생성·수정·삭제, 역할 변경과 버틀러 가입 승인을 수행할 수 있습니다.
            button(type="button", (click)="openInvite()", class="h-11 shrink-0 rounded-xl bg-white px-4 text-xs font-extrabold text-[#234E29]") + 계정 추가

    main(class="mx-auto max-w-5xl px-4 pb-32 pt-5")
        section(class="rounded-2xl border border-[#DCE5D9] bg-white p-4")
            p(class="text-xs font-black text-[#344333]") 역할별 계정 찾기
            div(class="mt-3 flex flex-wrap gap-2")
                button(type="button", (click)="filterByRole('')", class="rounded-full px-3 py-1.5 text-[10px] font-extrabold", [ngClass]="search.role === '' ? 'bg-[#234E29] text-white' : 'bg-[#F1F5EF] text-[#657463]'") 전체
                button(*ngFor="let role of roles", type="button", (click)="filterByRole(role.value)", class="rounded-full px-3 py-1.5 text-[10px] font-extrabold", [ngClass]="search.role === role.value ? 'bg-[#234E29] text-white' : 'bg-[#F1F5EF] text-[#657463]'") {{role.label}}

        p(*ngIf="loading", class="py-12 text-center text-xs text-[#71806F]") 계정을 불러오는 중입니다.
        p(*ngIf="!loading && members.length === 0", class="py-12 text-center text-xs text-[#71806F]") 조건에 맞는 계정이 없습니다.

        section(*ngIf="!loading && members.length > 0", class="mt-4 space-y-3")
            article(*ngFor="let member of members", class="rounded-2xl border border-[#DCE5D9] bg-white p-4 shadow-sm")
                div(class="flex items-start gap-3")
                    div(class="flex size-10 shrink-0 items-center justify-center rounded-full text-sm font-black", [ngClass]="member.avatarColor") {{member.name?.charAt(0) || '?'}}
                    div(class="min-w-0 flex-1")
                        div(class="flex flex-wrap items-center gap-2")
                            p(class="text-xs font-black text-[#344333]") {{member.name}}
                            span(class="rounded-full px-2 py-0.5 text-[9px] font-extrabold", [ngClass]="roleClass(member.role)") {{roleName(member.role)}}
                        p(class="mt-1 truncate text-[10px] text-[#7B8879]") {{member.id}} · {{member.email}} · 생성 {{member.joined}}

                div(class="mt-4 grid gap-3 sm:grid-cols-2")
                    label
                        span(class="mb-1 block text-[10px] font-bold text-[#657463]") 이름
                        input([(ngModel)]="member.editName", class="h-10 w-full rounded-xl border border-[#D7E0D5] px-3 text-xs")
                    label
                        span(class="mb-1 block text-[10px] font-bold text-[#657463]") 역할
                        select([(ngModel)]="member.editRole", class="h-10 w-full rounded-xl border border-[#D7E0D5] bg-white px-3 text-xs")
                            option(*ngFor="let role of roles", [value]="role.value") {{role.label}}
                button(*ngIf="member.role === 'butler_pending'", type="button", (click)="approveButler(member)", class="mt-3 h-11 w-full rounded-xl bg-[#0F766E] text-[10px] font-extrabold text-white") 마켓 버틀러 가입 승인
                div(class="mt-3 grid grid-cols-2 gap-2")
                    button(type="button", (click)="updateMember(member)", class="h-10 rounded-xl bg-[#2E7D32] text-[10px] font-extrabold text-white") 변경 저장
                    button(type="button", (click)="removeMember(member)", class="h-10 rounded-xl border border-[#E7B7AA] bg-[#FFF7F4] text-[10px] font-extrabold text-[#B74931]") 계정 삭제

    div(*ngIf="showInviteModal", class="absolute inset-0 z-50 flex items-center justify-center bg-black/45 p-4 backdrop-blur-sm")
        section(class="max-h-[90%] w-full max-w-md overflow-y-auto rounded-2xl bg-white shadow-xl")
            div(class="border-b border-[#E5EBE3] px-5 py-4")
                h2(class="text-base font-black text-[#344333]") 새 계정 만들기
                p(class="mt-1 text-[10px] text-[#71806F]") 역할을 지정해 관리자·상인·소비자 계정을 생성합니다.
            div(class="space-y-3 px-5 py-5")
                label
                    span(class="mb-1 block text-[10px] font-bold text-[#526150]") 아이디
                    input([(ngModel)]="inviteData.identifier", placeholder="영문·숫자 3~32자", class="h-11 w-full rounded-xl border border-[#D7E0D5] px-3 text-xs")
                label
                    span(class="mb-1 block text-[10px] font-bold text-[#526150]") 이메일
                    input(type="email", [(ngModel)]="inviteData.email", placeholder="name@example.com", class="h-11 w-full rounded-xl border border-[#D7E0D5] px-3 text-xs")
                label
                    span(class="mb-1 block text-[10px] font-bold text-[#526150]") 이름
                    input([(ngModel)]="inviteData.name", placeholder="담당자 이름", class="h-11 w-full rounded-xl border border-[#D7E0D5] px-3 text-xs")
                label
                    span(class="mb-1 block text-[10px] font-bold text-[#526150]") 초기 비밀번호
                    input(type="password", [(ngModel)]="inviteData.password", placeholder="8자 이상", class="h-11 w-full rounded-xl border border-[#D7E0D5] px-3 text-xs")
                label
                    span(class="mb-1 block text-[10px] font-bold text-[#526150]") 역할
                    select([(ngModel)]="inviteData.role", class="h-11 w-full rounded-xl border border-[#D7E0D5] bg-white px-3 text-xs")
                        option(*ngFor="let role of roles", [value]="role.value") {{role.label}}
            div(class="grid grid-cols-2 gap-2 border-t border-[#E5EBE3] bg-[#F7FAF6] px-5 py-4")
                button(type="button", (click)="showInviteModal = false", class="h-11 rounded-xl border border-[#D7E0D5] bg-white text-xs font-extrabold text-[#657463]") 취소
                button(type="button", (click)="invite()", class="h-11 rounded-xl bg-[#2E7D32] text-xs font-extrabold text-white") 계정 생성
