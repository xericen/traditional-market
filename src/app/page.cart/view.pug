div(class="mx-auto w-full px-4 pb-40 pt-5")
    header
        h1(class="text-3xl font-black tracking-[-0.04em] text-[#2F241D]") 장바구니
        p(class="mt-2 text-sm leading-5 text-[#7B6D62]") 담은 상품을 확인하고 수량을 조절해 보세요.

    div(*ngIf="cartItems.length === 0", class="mt-8 flex min-h-[480px] flex-col items-center justify-center rounded-[28px] border border-dashed border-[#D9CCC1] bg-[#FFFDF8] px-6 text-center")
        div(class="flex size-24 items-center justify-center rounded-full bg-[#FFF0DD] text-5xl") 🧺
        h2(class="mt-6 text-xl font-black text-[#3E3229]") 장바구니가 비어 있어요.
        p(class="mt-2 max-w-sm text-sm leading-6 text-[#85776C]") 오늘 버틀러가 확인한 홍천시장의 좋은 상품을 골라보세요.
        a(routerLink="/posts", class="mt-6 inline-flex h-12 items-center rounded-xl bg-[#E96B2C] px-5 text-sm font-extrabold text-white") 오늘의 시장 둘러보기

    section(*ngIf="cartItems.length > 0", class="mt-7 overflow-hidden rounded-[24px] border border-[#E5D9CE] bg-[#FFFDF8]")
        div(class="flex items-center justify-between border-b border-[#EEE4DB] px-4 py-4")
            div
                h2(class="text-base font-extrabold text-[#3D3128]") 담은 상품
                p(class="mt-0.5 text-[11px] text-[#8B7E73]") {{cartCount}}개 · {{shopCount}}곳의 점포
            button(type="button", (click)="clearCart()", class="min-h-9 rounded-lg px-2 text-xs font-bold text-[#9A6F57] hover:bg-[#FFF1ED] hover:text-[#C9492C]") 전체 비우기

        div(class="divide-y divide-[#EEE4DB]")
            article(*ngFor="let item of cartItems", class="p-4")
                div(class="flex gap-3")
                    a(routerLink="/posts/{{item.id}}/detail", class="flex size-24 shrink-0 items-center justify-center rounded-2xl text-5xl", [ngClass]="item.bg", [attr.aria-label]="item.name + ' 상세 보기'") {{item.emoji}}
                    div(class="min-w-0 flex-1")
                        div(class="flex items-start justify-between gap-2")
                            div(class="min-w-0")
                                p(class="truncate text-[11px] font-semibold text-[#8B7E73]") {{item.shop}}
                                a(routerLink="/posts/{{item.id}}/detail", class="mt-1 block text-sm font-extrabold leading-5 text-[#342A23]") {{item.name}}
                                p(class="mt-1.5 text-sm font-black text-[#342A23]") {{item.price | number}}원
                                    span(class="ml-1 text-[10px] font-medium text-[#8B7E73]") / {{item.unit}}
                            button(type="button", (click)="removeItem(item)", class="flex size-9 shrink-0 items-center justify-center rounded-lg text-[#9B8D82] hover:bg-[#FFF1ED] hover:text-[#C9492C]", [attr.aria-label]="item.name + ' 삭제'")
                                svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="1.8", class="size-4", aria-hidden="true")
                                    path(d="m6 6 12 12M18 6 6 18", stroke-linecap="round")

                        div(class="mt-4 flex flex-wrap items-center justify-between gap-3")
                            button(type="button", (click)="toggleSubstitute(item)", class="inline-flex min-h-9 items-center gap-2 rounded-lg px-2 py-1.5 text-[10px] font-bold", [ngClass]="item.substitute ? 'bg-[#EFF8F0] text-[#2E7D32]' : 'bg-[#F5EEE7] text-[#82746A]'", [attr.aria-pressed]="item.substitute")
                                span(class="flex size-4 items-center justify-center rounded border", [ngClass]="item.substitute ? 'border-[#2E7D32] bg-[#2E7D32] text-white' : 'border-[#CBBEB3]'") {{item.substitute ? '✓' : ''}}
                                span 대체 제안 허용
                            div(class="flex items-center rounded-xl border border-[#DED2C7] bg-white p-0.5")
                                button(type="button", (click)="changeQuantity(item, -1)", [disabled]="item.quantity <= 1", class="flex size-9 items-center justify-center rounded-lg text-base font-bold text-[#75675D] hover:bg-[#F5EEE7] disabled:cursor-not-allowed disabled:opacity-35", [attr.aria-label]="item.name + ' 수량 줄이기'") −
                                span(class="w-8 text-center text-xs font-extrabold", aria-live="polite") {{item.quantity}}
                                button(type="button", (click)="changeQuantity(item, 1)", [disabled]="item.stock && item.quantity >= item.stock", class="flex size-9 items-center justify-center rounded-lg text-base font-bold text-[#75675D] hover:bg-[#F5EEE7] disabled:cursor-not-allowed disabled:opacity-35", [attr.aria-label]="item.name + ' 수량 늘리기'") +

    div(*ngIf="cartItems.length > 0", class="cart-order-dock")
        button(type="button", (click)="startCheckout()", class="flex min-h-[58px] min-w-[218px] items-center justify-between gap-4 rounded-2xl bg-[#E96B2C] px-4 py-3 text-white shadow-[0_16px_34px_rgba(128,60,22,0.30)] transition hover:bg-[#D85A20] focus:outline-none focus:ring-2 focus:ring-[#E96B2C] focus:ring-offset-2")
            span(class="text-left")
                span(class="block text-[10px] font-bold text-white/80") 총 {{cartCount}}개
                span(class="mt-0.5 block text-base font-black") {{subtotal | number}}원
            span(class="inline-flex items-center gap-1.5 text-sm font-extrabold")
                span 주문하기
                svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", class="size-4", aria-hidden="true")
                    path(d="m9 5 7 7-7 7", stroke-linecap="round", stroke-linejoin="round")
