div(class="mx-auto w-full max-w-7xl px-4 py-5    ")
    nav(class="mb-5 flex items-center gap-2 text-xs font-semibold text-[#8B7E73]", aria-label="경로")
        a(routerLink="/dashboard", class="hover:text-[#E96B2C]") 홈
        span /
        a(routerLink="/posts", class="hover:text-[#E96B2C]") 오늘의 시장
        span /
        span(class="truncate text-[#53463C]") {{product.name}}

    div(class="grid gap-6  ")
        section
            div(class="relative flex min-h-[360px] items-center justify-center overflow-hidden rounded-[28px] border border-[#E4D7CB] ", [ngClass]="product.bg")
                span(class="text-[130px] drop-shadow-[0_24px_20px_rgba(68,43,23,0.16)] ") {{product.emoji}}
                div(class="absolute left-4 top-4 flex flex-wrap gap-2")
                    span(class="rounded-full bg-white/90 px-3 py-1.5 text-[10px] font-extrabold text-[#2E7D32] shadow-sm") ✓ 오늘 버틀러 확인
                    span(*ngIf="product.signature", class="rounded-full bg-[#2F241D] px-3 py-1.5 text-[10px] font-extrabold text-white shadow-sm") 홍천 시그니처
                button(type="button", (click)="toggleVideo()", class="absolute bottom-4 left-4 right-4 flex items-center gap-3 rounded-2xl bg-[#2F241D]/85 p-3 text-left text-white shadow-xl backdrop-blur  ")
                    span(class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-[#E96B2C]")
                        svg(*ngIf="!isPlaying", viewBox="0 0 24 24", fill="currentColor", class="ml-0.5 size-5")
                            path(d="m8 5 11 7-11 7V5Z")
                        svg(*ngIf="isPlaying", viewBox="0 0 24 24", fill="currentColor", class="size-5")
                            path(d="M7 5h4v14H7zm6 0h4v14h-4z")
                    span(class="min-w-0 flex-1")
                        span(class="block text-[10px] font-bold text-[#FFD5A5]") SAMPLE 15s · 현장 영상 시연
                        span(class="mt-0.5 block truncate text-xs font-extrabold") {{isPlaying ? '샘플 재생 중 · 버틀러 설명' : '실제 촬영물 연동 전 샘플입니다'}}
                    span →

            div(class="mt-3 grid grid-cols-3 gap-2")
                button(type="button", (click)="selectInfo('product')", [class]="mediaClass('product')")
                    span(class="text-xl") {{product.emoji}}
                    span 상품
                button(type="button", (click)="selectInfo('butler')", [class]="mediaClass('butler')")
                    span(class="text-xl") 👀
                    span 검수
                button(type="button", (click)="selectInfo('store')", [class]="mediaClass('store')")
                    span(class="text-xl") 🏪
                    span 점포

        aside(class="  ")
            div(class="rounded-[28px] border border-[#E5D9CE] bg-[#FFFDF8] p-5 shadow-[0_18px_50px_rgba(65,45,30,0.08)] ")
                div(class="flex items-start justify-between gap-4")
                    div
                        p(class="text-xs font-bold text-[#8B7E73]") {{product.shop}}
                        h1(class="mt-2 text-2xl font-black tracking-[-0.04em] text-[#2F241D] ") {{product.name}}
                    button(type="button", (click)="toggleFavorite()", class="flex size-10 shrink-0 items-center justify-center rounded-xl border border-[#E2D6CB] bg-white", [ngClass]="favorite ? 'text-[#E96B2C]' : 'text-[#8B7E73]'", [attr.aria-label]="favorite ? '찜 해제' : '찜하기'")
                        svg(viewBox="0 0 24 24", [attr.fill]="favorite ? 'currentColor' : 'none'", stroke="currentColor", stroke-width="1.8", class="size-5")
                            path(d="M20.8 5.8a5 5 0 0 0-7.1 0L12 7.5l-1.7-1.7a5 5 0 0 0-7.1 7.1L12 21l8.8-8.1a5 5 0 0 0 0-7.1Z", stroke-linejoin="round")

                div(class="mt-5 flex items-end gap-2")
                    p(class="text-3xl font-black text-[#2F241D]") {{product.price | number}}원
                    p(class="pb-1 text-xs font-semibold text-[#8B7E73]") / {{product.unit}}

                div(class="mt-5 grid grid-cols-2 gap-2")
                    div(class="rounded-2xl bg-[#F5EFE8] p-3")
                        p(class="text-[10px] font-bold text-[#998B80]") 오늘 남은 수량
                        p(class="mt-1 text-sm font-extrabold", [ngClass]="product.stock <= 5 ? 'text-[#C9492C]' : 'text-[#2E7D32]'") {{product.stock}}개
                    div(class="rounded-2xl bg-[#F5EFE8] p-3")
                        p(class="text-[10px] font-bold text-[#998B80]") 주문 마감
                        p(class="mt-1 text-sm font-extrabold text-[#4F4137]") 오늘 {{product.cutoff}}

                div(class="mt-5 rounded-2xl border border-[#C7E7CC] bg-[#EFF8F0] p-4")
                    div(class="flex items-center gap-2")
                        span(class="flex size-8 items-center justify-center rounded-xl bg-[#2E7D32] text-sm text-white") B
                        div
                            p(class="text-xs font-extrabold text-[#315A32]") 오늘의 버틀러 · 민서
                            p(class="text-[10px] text-[#6F806C]") 오전 9:42 현장 확인
                    p(class="mt-3 text-xs leading-5 text-[#4C654C]") “{{product.butlerNote}}”

                div(class="mt-6")
                    div(class="flex items-center justify-between")
                        label(class="text-sm font-extrabold text-[#45382F]") 수량
                        div(class="flex items-center rounded-xl border border-[#DED2C7] bg-white p-1")
                            button(type="button", (click)="changeQuantity(-1)", class="flex size-9 items-center justify-center rounded-lg text-lg font-bold text-[#75675D] hover:bg-[#F5EEE7]", aria-label="수량 줄이기") −
                            span(class="w-10 text-center text-sm font-extrabold") {{quantity}}
                            button(type="button", (click)="changeQuantity(1)", class="flex size-9 items-center justify-center rounded-lg text-lg font-bold text-[#75675D] hover:bg-[#F5EEE7]", aria-label="수량 늘리기") +

                button(type="button", (click)="toggleSubstitute()", class="mt-4 flex w-full items-start gap-3 rounded-2xl border p-3.5 text-left transition", [ngClass]="substitute ? 'border-[#C7E7CC] bg-[#F4FAF3]' : 'border-[#E4D7CB] bg-white'")
                    span(class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-md border text-xs font-black", [ngClass]="substitute ? 'border-[#2E7D32] bg-[#2E7D32] text-white' : 'border-[#CFC2B7] text-transparent'") ✓
                    span
                        span(class="block text-xs font-extrabold text-[#4A3D34]") 품절 시 비슷한 상품 제안 받기
                        span(class="mt-1 block text-[10px] leading-4 text-[#8B7E73]") 버틀러가 사진과 가격을 보내드린 뒤 승인받아요.

                div(class="mt-6 grid grid-cols-[1fr_1.55fr] gap-2.5")
                    button(type="button", (click)="addToCart(false)", class="h-[52px] rounded-2xl border border-[#E96B2C] bg-[#FFF8EF] px-3 py-3.5 text-sm font-extrabold text-[#C85A1E] transition hover:bg-[#FFF0DD]") 장바구니
                    button(type="button", (click)="addToCart(true)", class="h-[52px] rounded-2xl bg-[#E96B2C] px-3 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-orange-900/10 transition hover:bg-[#D85A20]") 바로 주문하기

                p(class="mt-3 text-center text-[10px] text-[#9A8D82]") 결제 전 배송 또는 시장 픽업을 선택할 수 있어요.

    section(class="mt-12 grid gap-5 ")
        article(class="rounded-[24px] border border-[#E5D9CE] bg-[#FFFDF8] p-5 ")
            div(class="flex items-center gap-3")
                span(class="flex size-11 items-center justify-center rounded-2xl bg-[#FFE6C9] text-xl") 🏪
                div
                    p(class="text-xs font-bold text-[#A35A2D]") 점포 이야기
                    h2(class="text-lg font-extrabold text-[#352A23]") {{product.shop}}
            p(class="mt-4 text-sm leading-7 text-[#74675D]") {{product.storeStory}}
            div(class="mt-4 flex items-center gap-2 text-xs font-bold text-[#6C5C50]")
                span(class="rounded-full bg-[#F5EEE7] px-2.5 py-1") 홍천중앙시장 안동
                span(class="rounded-full bg-[#F5EEE7] px-2.5 py-1") 오늘 직접 제조

        article(class="rounded-[24px] border border-[#C7E7CC] bg-[#F7FBF5] p-5 ")
            p(class="text-xs font-bold text-[#2E7D32]") 포장 전에 이렇게 확인해요
            h2(class="mt-1 text-lg font-extrabold text-[#352A23]") 버틀러 4단계 검수
            div(class="mt-4 grid grid-cols-2 gap-2")
                div(*ngFor="let item of inspectionItems", class="flex items-center gap-2 rounded-xl bg-white px-3 py-2.5 text-xs font-bold text-[#536350]")
                    span(class="flex size-5 items-center justify-center rounded-full bg-[#DFF3E2] text-[10px] text-[#2E7D32]") ✓
                    span {{item}}
